# Copie para .env.lancamento.local (ou coloque no mobile/.env; nenhum vai para o Git) e preencha.
# R2_ACCOUNT_ID é o ID da conta (32 caracteres a-f/0-9), não o token.
# Cloudflare → R2 → Manage R2 API Tokens → Create API token (permissão "Object Read & Write" no bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seniorai-app
R2_CHAVE=seniorai/seniorai.apk
