{
  "name": "senior-ai-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Senior AI (assistente executivo inteligente)",
  "scripts": {
    "dev": "node --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/shared/infra/http/server.ts",
    "dev:worker": "node --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/shared/infra/queue/worker.ts",
    "build": "babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored --ignore \"src/**/*.spec.ts\",\"src/shared/testes/**\"",
    "start": "node ./dist/shared/infra/http/server.js",
    "start:worker": "node ./dist/shared/infra/queue/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "docker compose up -d database redis",
    "migration:generate": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/shared/infra/typeorm/cli.ts",
    "migration:create": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "migration:run": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/shared/infra/typeorm/cli.ts",
    "migration:revert": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/shared/infra/typeorm/cli.ts",
    "migration:show": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/shared/infra/typeorm/cli.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "bullmq": "6.7.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "swagger-ui-express": "5.0.1",
    "tsyringe": "4.10.0",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/swagger-ui-express": "4.1.8",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-transform-typescript-metadata": "0.3.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "5.1.0"
  }
}
