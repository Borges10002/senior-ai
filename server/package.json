{
  "name": "senior-ai-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:local": "node scripts/run-environment.cjs local dev",
    "migration:generate": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/shared/infra/typeorm/cli.ts",
    "migration:create": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "migration:run": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/shared/infra/typeorm/cli.ts",
    "migration:revert": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/shared/infra/typeorm/cli.ts",
    "migration:show": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/shared/infra/typeorm/cli.ts",
    "dev:online": "node scripts/run-environment.cjs online dev",
    "start:local": "node scripts/run-environment.cjs local start",
    "start:online": "node scripts/run-environment.cjs online start",
    "db:local": "docker compose up -d database redis",
    "admin:promover": "ts-node -r tsconfig-paths/register --transpile-only src/shared/infra/scripts/definirPerfil.ts",
    "admin:promover:online": "node scripts/run-environment.cjs online admin:promover",
    "admin:promover:dist": "node ./dist/shared/infra/scripts/definirPerfil.js",
    "dev": "node --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/shared/infra/http/server.ts",
    "start": "node ./dist/shared/infra/http/server.js",
    "build": "npx babel src --extensions \".js,.ts\" --out-dir dist --copy-files --no-copy-ignored --ignore \"src/**/*.spec.ts\",\"src/shared/testes/**\"",
    "test:postgres": "node scripts/test-security-postgres.cjs",
    "dev:worker": "node --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/shared/infra/queue/worker.ts",
    "start:worker": "node ./dist/shared/infra/queue/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "API do Senior AI (assistente executivo inteligente)",
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/node": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "22.20.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "6.4.24",
    "@types/swagger-ui-express": "^4.1.6",
    "bcryptjs": "3.0.3",
    "bullmq": "6.7.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "10.3.1",
    "openai": "7.52.0",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.20",
    "zod": "4.6.7"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
