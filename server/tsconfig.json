{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "commonjs",
    "target": "ES2022",
    "baseUrl": "./src",
    "outDir": "./dist",

    "paths": {
      "@config/*": ["config/*"],
      "@modules/*": ["modules/*"],
      "@errors/*": ["errors/*"],
      "@shared/*": ["shared/*"],
      "@utils/*": ["utils/*"],
      "@middleawares/*": ["shared/infra/http/middleawares/*"],
      "@/*": ["./*"]
    },

    "strict": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
