NODE_ENV=development
PORT=3333

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=senior_ai
DB_PASS=SUBSTITUIR_POR_SENHA_FORTE
DB_NAME=senior_ai

# JWT
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO
JWT_REFRESH_SECRET=SUBSTITUIR_POR_OUTRO_SEGREDO
JWT_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN="2d"
JWT_ID="senior-ai-api"
CORS_ORIGINS="http://localhost:9000,http://localhost:8081"
UPLOAD_TMP_DIR="tmp/uploads"

# Planos (SaaS) - plano único Pro com teste grátis; depois disso a conta fica só leitura
PLANOS_ATIVOS=true
TRIAL_DIAS=14
CARENCIA_DIAS=3
PLANO_PRO_MENSAL=19.90
PLANO_PRO_ANUAL=199.00

# Asaas - sandbox: https://api-sandbox.asaas.com/v3 | produção: https://api.asaas.com/v3
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Mesmo token configurado no webhook do painel Asaas (32+ caracteres). URL: <API>/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=""

# E-mail (recuperação de senha).
# Use MailerSend (token da API) OU SMTP. Sem nenhum dos dois nada é enviado
# (em desenvolvimento o link de troca de senha aparece no log).
MAILERSEND_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="Senior AI <nao-responda@dimitech.com.br>"
# Endereço do web usado nos links dos e-mails
WEB_URL=https://seniorai.dimitech.com.br

# Opcional: CA PEM do PostgreSQL, quando o provedor usa uma CA privada.
# A validacao do certificado permanece habilitada.
DB_SSL_CA=

# Producao: JWT_SECRET e JWT_REFRESH_SECRET diferentes, aleatorios e com pelo menos 32 bytes.
# Sem JWT_REFRESH_SECRET, uma chave separada e derivada de JWT_SECRET.
# CORS_ORIGINS deve listar origens HTTPS exatas, sem caminhos ou barra final.

# Fuso usado nas datas do sistema
APP_TIMEZONE=America/Porto_Velho

# Redis (filas BullMQ). No Docker o compose força REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

# Fase 3 - provedor de IA (configurável)
AI_PROVIDER=
AI_API_KEY=

# Fase 2 - armazenamento privado de áudio/PDF (S3 ou Cloudflare R2)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Portas publicadas no host pelo docker-compose (só 127.0.0.1). Mude se já estiverem em uso.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
