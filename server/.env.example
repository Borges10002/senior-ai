# Copie para .env (Docker) e/ou .env.local (npm run dev fora do Docker).
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=3333
APP_TIMEZONE=America/Porto_Velho

# Banco. No Docker o docker-compose força DB_HOST=database; fora dele use localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=senior_ai
DB_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE
DB_NAME=senior_ai
# Alternativa a DB_*: DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# DB_SSL=true  (banco gerenciado com TLS)

# Redis. No Docker o docker-compose força REDIS_HOST=redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

# JWT: segredos diferentes, aleatórios, com 32+ bytes (a API recusa subir em produção sem isso).
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO
JWT_REFRESH_SECRET=SUBSTITUIR_POR_OUTRO_SEGREDO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Fronts autorizados (web Quasar e Expo web), separados por vírgula. Em produção, só HTTPS.
CORS_ORIGINS=http://localhost:9000,http://localhost:8081

# Fase 3 - provedor de IA (configurável)
AI_PROVIDER=
AI_API_KEY=

# Fase 2 - armazenamento privado de áudio/PDF (S3 ou Cloudflare R2)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Portas publicadas no host pelo docker-compose (só 127.0.0.1). Mude se já estiverem em uso.
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
